{
  "schemaVersion": 1,
  "id": "mekanismadditions",
  "version": "${version}",
  "name": "Mekanism: Additions (Fabric)",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mekanism.additions.common.MekanismAdditions"
    ],
    "client": [
      "mekanism.additions.client.AdditionsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "mekanism": "${version}"
  },
  "license": "MIT",
  "mixins": [
    "mekanismadditions.mixins.json"
  ],
  "description": "Mekanism Additions for Fabric: plastic blocks, balloons, glow panels and the Mekanism glider. Part of the Mekanism Fabric port.",
  "contact": {
    "homepage": "https://aidancbrady.com/mekanism/",
    "sources": "https://github.com/mekanism/Mekanism"
  },
  "authors": [
    "Aidan C. Brady",
    "Mekanism contributors"
  ],
  "icon": "logo.png"
}
