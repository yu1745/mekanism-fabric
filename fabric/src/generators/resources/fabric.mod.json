{
  "schemaVersion": 1,
  "id": "mekanismgenerators",
  "version": "${version}",
  "name": "Mekanism: Generators (Fabric)",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mekanism.generators.common.MekanismGenerators"
    ],
    "client": [
      "mekanism.generators.client.GeneratorsClient"
    ],
    "mekanism:chemicals": [
      "mekanism.fabric.generators.GeneratorsRegistryRegistration::chemicals"
    ],
    "mekanism:modules": [
      "mekanism.fabric.generators.GeneratorsRegistryRegistration::modules"
    ],
    "mekanism:module_support": [
      "mekanism.fabric.generators.GeneratorsRegistryRegistration::support"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "mekanism": "${version}"
  },
  "license": "MIT",
  "mixins": [
    "mekanismgenerators.mixins.json"
  ],
  "description": "Mekanism Generators for Fabric: solar, heat, gas, bio, wind, fission and fusion power. Part of the Mekanism Fabric port.",
  "contact": {
    "homepage": "https://aidancbrady.com/mekanism/",
    "sources": "https://github.com/mekanism/Mekanism"
  },
  "authors": [
    "Aidan C. Brady",
    "Mekanism contributors"
  ],
  "icon": "logo.png"
}
