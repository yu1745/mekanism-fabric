{
  "schemaVersion": 1,
  "id": "mekanism",
  "version": "${version}",
  "name": "Mekanism (Fabric)",
  "description": "Mekanism for Fabric: ore processing, energy, chemicals, machines, tools, generators and more. Unofficial port of the official NeoForge build 10.7.19.85.",
  "authors": [
    "Aidan C. Brady",
    "Mekanism contributors"
  ],
  "contact": {
    "homepage": "https://aidancbrady.com/mekanism/",
    "sources": "https://github.com/mekanism/Mekanism"
  },
  "license": "MIT",
  "environment": "*",
  "accessWidener": "mekanism.accesswidener",
  "mixins": [
    "mekanism.mixins.json",
    {
      "config": "mekanism.client.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "main": [
      "mekanism.fabric.MekanismFabricBootstrap"
    ],
    "client": [
      "mekanism.fabric.MekanismFabricClientBootstrap"
    ],
    "emi": [
      "mekanism.client.recipe_viewer.emi.MekanismEmi"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.116.17",
    "team_reborn_energy": ">=4.1.0"
  },
  "icon": "assets/mekanism/icon.png",
  "suggests": {
    "emi": "*"
  }
}
