{
  "schemaVersion": 1,
  "id": "mekanism",
  "version": "${version}",
  "name": "Mekanism (Fabric Bootstrap)",
  "description": "Minimal Java bootstrap for the incremental Mekanism Fabric port.",
  "authors": [
    "Aidan C. Brady",
    "Mekanism contributors"
  ],
  "contact": {
    "homepage": "https://aidancbrady.com/mekanism/",
    "sources": "https://github.com/mekanism/Mekanism"
  },
  "license": "MIT",
  "environment": "*",
  "accessWidener": "mekanism.accesswidener",
  "mixins": [
    {
      "config": "mekanism.client.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "main": [
      "mekanism.fabric.MekanismFabricBootstrap"
    ],
    "client": [
      "mekanism.fabric.MekanismFabricClientBootstrap"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.116.17",
    "team_reborn_energy": ">=4.1.0"
  }
}
