{
  "schemaVersion": 1,
  "id": "mekanismtools",
  "version": "${version}",
  "name": "Mekanism: Tools (Fabric)",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mekanism.tools.common.MekanismTools"
    ],
    "client": [
      "mekanism.tools.client.ToolsClient"
    ]
  },
  "mixins": [
    "mekanismtools.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "mekanism": "${version}"
  },
  "license": "MIT",
  "description": "Mekanism Tools for Fabric: paxels and osmium/bronze/steel/refined obsidian gear. Part of the Mekanism Fabric port.",
  "contact": {
    "homepage": "https://aidancbrady.com/mekanism/",
    "sources": "https://github.com/mekanism/Mekanism"
  },
  "authors": [
    "Aidan C. Brady",
    "Mekanism contributors"
  ],
  "icon": "logo.png"
}
